<!DOCTYPE html><html><head><meta charset="utf-8"><title>API Key</title>
<style>body{font-family:system-ui;background:#0f172a;color:#e2e8f0;display:flex;align-items:center;justify-content:center;height:100vh;margin:0}
.card{background:#1e293b;padding:32px;border-radius:12px;width:480px}
code{display:block;background:#0f172a;padding:12px;border-radius:6px;word-break:break-all;margin:12px 0}
button{padding:10px 16px;background:#22c55e;border:none;border-radius:6px;color:#fff;cursor:pointer;margin-right:8px}
a{color:#38bdf8;text-decoration:none;display:inline-block;margin-top:12px}
.err{color:#f87171}</style></head>
<body><div class="card"><h2>OpenWA Admin API Key</h2>
<% if(error){ %><div class="err">Gagal membaca API key dari container OpenWA.</div><% } else { %>
<code id="key"><%= key %></code>
<button onclick="navigator.clipboard.writeText(document.getElementById('key').textContent).then(()=>alert('Copied'))">Copy</button>
<% } %>
<a href="/users">Back</a>
</div></body></html>