<!DOCTYPE html><html><head><meta charset="utf-8"><title>Users</title>
<style>body{font-family:system-ui;background:#0f172a;color:#e2e8f0;margin:0;padding:20px}
a{color:#38bdf8;text-decoration:none}
table{width:100%;border-collapse:collapse;margin-top:16px}
td,th{padding:10px;border-bottom:1px solid #334155;text-align:left}
.card{background:#1e293b;padding:20px;border-radius:12px;margin-bottom:16px}
input,select{padding:8px;margin:4px;border-radius:6px;border:1px solid #334155;background:#0f172a;color:#e2e8f0}
button{padding:8px 12px;background:#22c55e;border:none;border-radius:6px;color:#fff;cursor:pointer}
.danger{background:#ef4444}</style></head>
<body>
<h1>Portal Users</h1><a href="/auto-login">Back to OpenWA</a> | <a href="/password">Ganti password saya</a> | <a href="/api-key">API Key</a>
<div class="card">
<h2>Create User</h2>
<form method="post" action="/users/create">
<input name="username" placeholder="username" required>
<input name="password" type="password" placeholder="password" required>
<select name="role"><% roles.forEach(r=>{ %><option value="<%= r %>"><%= r %></option><% }) %></select>
<button type="submit">Create</button>
</form></div>
<table>
<tr><th>ID</th><th>Username</th><th>Role</th><th>Created</th><th>Actions</th></tr>
<% users.forEach(u=>{ %>
<tr>
<td><%= u.id %></td><td><%= u.username %></td><td><%= u.role %></td><td><%= u.created_at %></td>
<td>
<form method="post" action="/users/<%= u.id %>/role" style="display:inline">
<select name="role"><% roles.forEach(r=>{ %><option value="<%= r %>" <%= r===u.role?'selected':'' %>><%= r %></option><% }) %></select>
<button type="submit">Update</button>
</form>
<% if(String(u.id)!==String(user.id)){ %>
<form method="post" action="/users/<%= u.id %>/delete" style="display:inline"><button class="danger" type="submit">Delete</button></form>
<% } %>
</td>
</tr>
<% }) %>
</table>
</body></html>